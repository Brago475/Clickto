<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Clickto.ViewModels"
        xmlns:svc="using:Clickto.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Clickto.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/clickto.png"
        Title="Clickto"
        Width="700" Height="760"
        MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        RequestedThemeVariant="{Binding IsDark, Converter={x:Static vm:ThemeConverter.Instance}}"
        Background="{DynamicResource Bg}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Bg" Color="#0A0A0B"/>
                    <SolidColorBrush x:Key="Surface" Color="#161618"/>
                    <SolidColorBrush x:Key="SurfaceAlt" Color="#101011"/>
                    <SolidColorBrush x:Key="Panel" Color="#141416"/>
                    <SolidColorBrush x:Key="PanelBorder" Color="#26262A"/>
                    <SolidColorBrush x:Key="ButtonBg" Color="#2A2A2F"/>
                    <SolidColorBrush x:Key="TextMain" Color="#E9E9EC"/>
                    <SolidColorBrush x:Key="TextTitle" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="TextMuted" Color="#8A8A93"/>
                    <SolidColorBrush x:Key="Divider" Color="#26262A"/>
                    <SolidColorBrush x:Key="Accent" Color="#06B6D4"/>
                    <SolidColorBrush x:Key="Amber" Color="#F59E0B"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Bg" Color="#F4F4F5"/>
                    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceAlt" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="PanelBorder" Color="#DFDFE3"/>
                    <SolidColorBrush x:Key="ButtonBg" Color="#E8E8EB"/>
                    <SolidColorBrush x:Key="TextMain" Color="#18181B"/>
                    <SolidColorBrush x:Key="TextTitle" Color="#000000"/>
                    <SolidColorBrush x:Key="TextMuted" Color="#6B6B73"/>
                    <SolidColorBrush x:Key="Divider" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="Accent" Color="#0891B2"/>
                    <SolidColorBrush x:Key="Amber" Color="#B45309"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.colhead">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.cellmuted">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="monospace"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.34"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="#04212A"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.record">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#2A0A0A"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.pause">
            <Setter Property="Background" Value="{DynamicResource Amber}"/>
            <Setter Property="Foreground" Value="#2A1A02"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="Foreground" Value="#FEE2E2"/>
        </Style>
        <Style Selector="Button.tiny">
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="MinHeight" Value="23"/>
        </Style>
        <Style Selector="Button.flash">
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="Foreground" Value="#052E14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.segoff">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="Button.segon">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="#04212A"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.segon:disabled">
            <Setter Property="Opacity" Value="1.0"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style Selector="TextBox.keyfield">
            <Setter Property="FontFamily" Value="monospace"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="MinHeight" Value="22"/>
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9"/>
        </Style>
        <Style Selector="Border.bar">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="Border.vsep">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
            <Setter Property="Margin" Value="4,3"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Classes="bar" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="/Assets/clickto.png" Width="22" Height="22"/>
                    <TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center">
                        <Run Text="Click" Foreground="{DynamicResource TextTitle}"/><Run Text="to" Foreground="{DynamicResource Accent}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Preset" Classes="hint" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PresetName}" Width="140"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" IsVisible="{Binding IsAdvanced}">
                    <Button Classes="tiny" Content="Import" Command="{Binding ImportTimelineCommand}"
                            IsEnabled="{Binding CanEdit}"/>
                    <Button Classes="tiny" Content="Export" Command="{Binding ExportTimelineCommand}"
                            IsEnabled="{Binding HasSteps}"/>
                    <Border Classes="vsep"/>
                    <ComboBox ItemsSource="{Binding LayoutOptions}"
                              SelectedItem="{Binding SelectedLayout}" Width="118"/>
                    <Button Classes="tiny" Content="Panels">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="8" Width="184">
                                    <TextBlock Classes="section" Text="VISIBLE PANELS"/>
                                    <CheckBox Content="Controls" IsChecked="{Binding ShowControlsPanel}"/>
                                    <CheckBox Content="Playback" IsChecked="{Binding ShowPlaybackPanel}"/>
                                    <CheckBox Content="Timeline" IsChecked="{Binding ShowTimelinePanel}"/>
                                    <CheckBox Content="Step editor" IsChecked="{Binding ShowPropertiesPanel}"/>
                                    <CheckBox Content="Hotkeys" IsChecked="{Binding ShowHotkeysPanel}"/>
                                    <CheckBox Content="Presets" IsChecked="{Binding ShowPresetsPanel}"/>
                                    <Border Classes="divider"/>
                                    <CheckBox Content="Inline help text" IsChecked="{Binding ShowHints}"/>
                                    <Button Classes="tiny" Content="Reset layout"
                                            Command="{Binding ResetPanelsCommand}"
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Border Grid.Column="4" Background="{DynamicResource ButtonBg}" CornerRadius="7"
                        Padding="2" Margin="10,0,8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="tiny" Content="Simple"
                                Classes.segon="{Binding !IsAdvanced}"
                                Classes.segoff="{Binding IsAdvanced}"
                                Command="{Binding ToggleModeCommand}"
                                IsEnabled="{Binding IsAdvanced}"/>
                        <Button Classes="tiny" Content="Advanced"
                                Classes.segon="{Binding IsAdvanced}"
                                Classes.segoff="{Binding !IsAdvanced}"
                                Command="{Binding ToggleModeCommand}"
                                IsEnabled="{Binding !IsAdvanced}"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="5" Classes="tiny" Width="54"
                        Content="{Binding IsDark, Converter={x:Static vm:ThemeIconConverter.Instance}}"
                        Command="{Binding ToggleThemeCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Panel Grid.Row="1">

            <Grid Margin="8" RowDefinitions="*,Auto" IsVisible="{Binding !IsStacked}">

                <Grid Grid.Row="0" ColumnDefinitions="234,*,236">

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="7" Margin="0,0,7,0">

                            <Border Classes="panel" IsVisible="{Binding ShowControlsPanel}">
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="section" Text="CONTROLS"/>

                                    <UniformGrid Columns="2">
                                        <Button Classes="record" Margin="0,0,3,0" HorizontalAlignment="Stretch"
                                                Content="Record"
                                                Command="{Binding RecordCommand}" IsEnabled="{Binding !IsRecording}"/>
                                        <Button Margin="3,0,0,0" HorizontalAlignment="Stretch"
                                                Content="Stop rec"
                                                Command="{Binding StopRecordingButtonCommand}"
                                                IsEnabled="{Binding IsRecording}"/>
                                    </UniformGrid>

                                    <UniformGrid Columns="2">
                                        <Button Classes="primary" Margin="0,0,3,0" HorizontalAlignment="Stretch"
                                                Content="Start"
                                                Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/>
                                        <Button Classes="pause" Margin="3,0,0,0" HorizontalAlignment="Stretch"
                                                Content="{Binding PauseButtonLabel}"
                                                Command="{Binding TogglePauseCommand}" IsEnabled="{Binding IsRunning}"/>
                                    </UniformGrid>

                                    <Button HorizontalAlignment="Stretch"
                                            Content="Stop"
                                            Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"/>

                                    <Border Classes="divider"/>

                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Status" Classes="hint" Width="46"/>
                                            <Border Width="7" Height="7" CornerRadius="4"
                                                    Background="{Binding StatusColor}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusText}" Classes="cell"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Actions" Classes="hint" Width="46"/>
                                            <TextBlock Classes="cell">
                                                <Run Text="{Binding LoadedCount}" Foreground="{DynamicResource Accent}" FontWeight="Bold"/><Run Text=" loaded"/>
                                            </TextBlock>
                                            <TextBlock Classes="hint" VerticalAlignment="Center"
                                                       IsVisible="{Binding IsRunning}"
                                                       Text="{Binding ActionsPerformed, StringFormat='{}{0} done'}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Elapsed" Classes="hint" Width="46"/>
                                            <TextBlock Text="{Binding ElapsedText}" Classes="cellmuted"/>
                                            <TextBlock Text="{Binding LoopProgress}" Classes="hint" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Log}" Classes="hint"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="panel" IsVisible="{Binding ShowPlaybackPanel}">
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="section" Text="PLAYBACK"/>

                                    <Grid ColumnDefinitions="62,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Repeat" Classes="cell"/>
                                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding LoopOptions}" SelectedItem="{Binding SelectedLoop}"
                                                      IsVisible="{Binding !IsCustomLoop}"/>
                                            <TextBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                     Text="{Binding CustomLoops, Converter={x:Static vm:IntTextConverter.Instance}}"
                                                     IsVisible="{Binding IsCustomLoop}"/>
                                            <Button Grid.Column="1" Classes="tiny" Content="List" Margin="4,0,0,0"
                                                    IsVisible="{Binding IsCustomLoop}"
                                                    Command="{Binding ClearCustomLoopCommand}"/>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed" Classes="cell"/>
                                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding SelectedSpeed}"
                                                      IsVisible="{Binding !IsCustomSpeed}"/>
                                            <TextBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                     Text="{Binding CustomSpeed, Converter={x:Static vm:DoubleTextConverter.Instance}}"
                                                     IsVisible="{Binding IsCustomSpeed}"/>
                                            <Button Grid.Column="1" Classes="tiny" Content="List" Margin="4,0,0,0"
                                                    IsVisible="{Binding IsCustomSpeed}"
                                                    Command="{Binding ClearCustomSpeedCommand}"/>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Start" Classes="cell"/>
                                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                     Text="{Binding StartDelayMs, Converter={x:Static vm:IntTextConverter.Instance}}"/>
                                            <TextBlock Grid.Column="1" Text="ms" Classes="hint"
                                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Loop" Classes="cell"/>
                                        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                     Text="{Binding LoopPauseMs, Converter={x:Static vm:IntTextConverter.Instance}}"/>
                                            <TextBlock Grid.Column="1" Text="ms" Classes="hint"
                                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </Grid>

                                    <Border Classes="divider"/>

                                    <CheckBox Content="Preserve recorded pauses" IsChecked="{Binding RemoveDelays}"/>
                                    <CheckBox Content="Natural clicks" IsChecked="{Binding NaturalClicks}"
                                              ToolTip.Tip="Varies timing, aim and press length each run"/>

                                    <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding NaturalClicks}">
                                        <TextBlock Text="Vary" Classes="hint" Width="30" VerticalAlignment="Center"/>
                                        <TextBox Width="44"
                                                 Text="{Binding DelayJitterPercent, Converter={x:Static vm:IntTextConverter.Instance}}"/>
                                        <TextBlock Text="%" Classes="hint" VerticalAlignment="Center"/>
                                        <TextBox Width="44"
                                                 Text="{Binding PositionJitterPx, Converter={x:Static vm:IntTextConverter.Instance}}"/>
                                        <TextBlock Text="px" Classes="hint" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <CheckBox Content="Smooth cursor travel" IsChecked="{Binding SmoothTravel}"
                                              ToolTip.Tip="Cursor arcs between actions instead of jumping"/>

                                    <Button Classes="tiny" Content="Apply speed permanently"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding BakeSpeedCommand}" IsEnabled="{Binding CanEdit}"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="panel" IsVisible="{Binding ShowHotkeysPanel}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section" Text="HOTKEYS"/>

                                    <Grid ColumnDefinitions="*,62,Auto"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="7">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Record" Classes="cell"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Classes="keyfield" Text="{Binding RecordKeyName}"/>
                                        <Button Grid.Row="0" Grid.Column="2" Classes="tiny" Content="Set"
                                                Margin="7,0,0,0" Command="{Binding CaptureRecordKeyCommand}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Stop rec" Classes="cell"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Classes="keyfield" Text="{Binding StopRecKeyName}"/>
                                        <Button Grid.Row="1" Grid.Column="2" Classes="tiny" Content="Set"
                                                Margin="7,0,0,0" Command="{Binding CaptureStopRecKeyCommand}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Start / Stop" Classes="cell"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Classes="keyfield" Text="{Binding StopKeyName}"/>
                                        <Button Grid.Row="2" Grid.Column="2" Classes="tiny" Content="Set"
                                                Margin="7,0,0,0" Command="{Binding CaptureStopKeyCommand}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Pause" Classes="cell"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Classes="keyfield" Text="{Binding PauseKeyName}"/>
                                        <Button Grid.Row="3" Grid.Column="2" Classes="tiny" Content="Set"
                                                Margin="7,0,0,0" Command="{Binding CapturePauseKeyCommand}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Emergency" Classes="cell"
                                                   Foreground="#EF4444"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Classes="keyfield" Text="{Binding EmergencyKeyName}"/>
                                        <Button Grid.Row="4" Grid.Column="2" Classes="tiny" Content="Set"
                                                Margin="7,0,0,0" Command="{Binding CaptureEmergencyKeyCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Classes="panel" IsVisible="{Binding ShowTimelinePanel}">
                        <Grid RowDefinitions="Auto,Auto,*">

                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Classes="section" Text="TIMELINE" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="hint" Text="{Binding TimelineSummary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,8">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                    <Button Classes="tiny" Content="+ Action" Command="{Binding AddStepCommand}"
                                            IsEnabled="{Binding CanEdit}"/>
                                    <Button Classes="tiny" Content="+ Delay" Command="{Binding AddDelayStepCommand}"
                                            IsEnabled="{Binding CanEdit}"/>
                                    <Border Classes="vsep"/>
                                    <Button Classes="tiny" Content="Up" Command="{Binding MoveStepUpCommand}"
                                            IsEnabled="{Binding HasSelection}"/>
                                    <Button Classes="tiny" Content="Down" Command="{Binding MoveStepDownCommand}"
                                            IsEnabled="{Binding HasSelection}"/>
                                    <Button Classes="tiny" Content="Copy" Command="{Binding DuplicateStepCommand}"
                                            IsEnabled="{Binding HasSelection}"/>
                                    <Button Classes="tiny" Content="Mute" Command="{Binding ToggleMuteStepCommand}"
                                            IsEnabled="{Binding HasSelection}"/>
                                    <Button Classes="tiny danger" Content="Delete" Command="{Binding DeleteStepCommand}"
                                            IsEnabled="{Binding HasSelection}"/>
                                </StackPanel>

                                <Button Grid.Column="1" Classes="tiny" Content="•••">
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="7" Width="210">
                                                <TextBlock Classes="section" Text="BULK EDIT"/>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Button Classes="tiny" Content="− 10 ms"
                                                            Command="{Binding NudgeFasterCommand}"
                                                            IsEnabled="{Binding HasSelection}"/>
                                                    <Button Classes="tiny" Content="+ 10 ms"
                                                            Command="{Binding NudgeSlowerCommand}"
                                                            IsEnabled="{Binding HasSelection}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBox Width="60"
                                                             Text="{Binding BulkDelayMs, Converter={x:Static vm:IntTextConverter.Instance}}"/>
                                                    <Button Classes="tiny" Content="Set all delays"
                                                            Command="{Binding SetAllDelaysCommand}"/>
                                                </StackPanel>
                                                <Border Classes="divider"/>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Button Classes="tiny" Content="Enable all"
                                                            Command="{Binding EnableAllCommand}"/>
                                                    <Button Classes="tiny" Content="Disable all"
                                                            Command="{Binding DisableAllCommand}"/>
                                                </StackPanel>
                                                <Border Classes="divider"/>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Button Classes="tiny" Content="Trim start"
                                                            Command="{Binding TrimBeforeCommand}"
                                                            IsEnabled="{Binding HasSelection}"/>
                                                    <Button Classes="tiny" Content="Trim end"
                                                            Command="{Binding TrimAfterCommand}"
                                                            IsEnabled="{Binding HasSelection}"/>
                                                </StackPanel>
                                                <Button Classes="tiny danger" Content="Clear timeline"
                                                        HorizontalAlignment="Stretch"
                                                        Command="{Binding ClearTimelineCommand}"
                                                        IsEnabled="{Binding HasSteps}"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}"
                                    BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                    CornerRadius="6" IsVisible="{Binding HasSteps}">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Border Grid.Row="0" Background="{DynamicResource Surface}"
                                            CornerRadius="6,6,0,0" MinHeight="28">
                                        <Grid ColumnDefinitions="30,116,*,74,58,62,44" Margin="10,0">
                                            <TextBlock Grid.Column="0" Classes="colhead" Text="#"/>
                                            <TextBlock Grid.Column="1" Classes="colhead" Text="TYPE"/>
                                            <TextBlock Grid.Column="2" Classes="colhead" Text="POSITION"/>
                                            <TextBlock Grid.Column="3" Classes="colhead" Text="DELAY"/>
                                            <TextBlock Grid.Column="4" Classes="colhead" Text="HOLD"/>
                                            <TextBlock Grid.Column="5" Classes="colhead" Text="BUTTON"/>
                                            <TextBlock Grid.Column="6" Classes="colhead" Text="ON"/>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ListBox ItemsSource="{Binding Timeline}"
                                                 SelectedItem="{Binding SelectedStep}"
                                                 Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StepRow">
                                                    <Grid ColumnDefinitions="30,116,*,74,58,62,44"
                                                          MinHeight="30" Margin="10,0">
                                                        <TextBlock Grid.Column="0" Text="{Binding Number}" Classes="cellmuted"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" Classes="cell"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding PositionText}" Classes="cellmuted"/>
                                                        <TextBox Grid.Column="3" Width="62" VerticalAlignment="Center"
                                                                 Text="{Binding DelayMs, Converter={x:Static vm:IntTextConverter.Instance}}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding HoldText}" Classes="cellmuted"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding ButtonText}" Classes="cellmuted"/>
                                                        <CheckBox Grid.Column="6" IsChecked="{Binding IsEnabled}"
                                                                  VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>

                                    <Border Grid.Row="2" Background="{DynamicResource Surface}"
                                            CornerRadius="0,0,6,6" Padding="10,5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="hint"
                                                       Text="Select a row to edit it in the step editor."/>
                                            <TextBlock Grid.Column="1" Classes="hint" Text="{Binding TotalDurationText}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" IsVisible="{Binding !HasSteps}"
                                    Background="{DynamicResource SurfaceAlt}"
                                    BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                    CornerRadius="6">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Spacing="10" MaxWidth="320">
                                    <TextBlock Text="No actions yet" FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Classes="hint" TextAlignment="Center"
                                               Text="Record your mouse actions, or add actions manually to build your sequence."/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <Button Classes="record" Content="Start recording"
                                                Command="{Binding RecordCommand}" IsEnabled="{Binding !IsRecording}"/>
                                        <Button Content="Add action" Command="{Binding AddStepCommand}"
                                                IsEnabled="{Binding CanEdit}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2" Margin="8,0,0,0" RowDefinitions="Auto,Auto,*"
                          IsVisible="{Binding IsThreeColumn}">

                        <Border Grid.Row="0" Classes="panel" IsVisible="{Binding ShowPropertiesPanel}">
                            <StackPanel Spacing="7">
                                <TextBlock Classes="section" Text="STEP EDITOR"/>

                                <StackPanel Spacing="7" IsVisible="{Binding !HasSelection}" Margin="0,32,0,36">
                                    <TextBlock Text="No action selected" Classes="cell" HorizontalAlignment="Center"/>
                                    <TextBlock Classes="hint" TextAlignment="Center"
                                               Text="Select a timeline row to edit its position, timing and click type."/>
                                </StackPanel>

                                <StackPanel Spacing="6"
                                            IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HasSelection}"
                                            DataContext="{Binding SelectedStep}">
                                    <Grid ColumnDefinitions="54,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Action" Classes="cell"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ActionTypeOptions}"
                                                  SelectedItem="{Binding Type}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="X / Y" Classes="cell"/>
                                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                            <TextBox Grid.Column="0" Text="{Binding X, Converter={x:Static vm:DoubleTextConverter.Instance}}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Y, Converter={x:Static vm:DoubleTextConverter.Instance}}"/>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Delay" Classes="cell"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                                                 Text="{Binding DelayMs, Converter={x:Static vm:IntTextConverter.Instance}}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Hold" Classes="cell"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                                                 Text="{Binding HoldMs, Converter={x:Static vm:IntTextConverter.Instance}}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Button" Classes="cell"/>
                                        <ComboBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MouseButtonOptions}"
                                                  SelectedItem="{Binding Button}"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Clicks" Classes="cell"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch"
                                                 Text="{Binding ClickCount, Converter={x:Static vm:IntTextConverter.Instance}}"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Scroll" Classes="cell"/>
                                        <TextBox Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch"
                                                 Text="{Binding ScrollAmount, Converter={x:Static vm:IntTextConverter.Instance}}"/>
                                    </Grid>

                                    <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Classes="panel" Margin="0,8,0,0">
                            <StackPanel Spacing="7">
                                <TextBlock Classes="section" Text="STOP CONDITIONS"/>

                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <CheckBox Content="Stop after" IsChecked="{Binding StopAfterActionsEnabled}"
                                                  MinWidth="86"/>
                                        <TextBox Width="56"
                                                 Text="{Binding StopAfterActions, Converter={x:Static vm:IntTextConverter.Instance}}"
                                                 IsEnabled="{Binding StopAfterActionsEnabled}"/>
                                        <TextBlock Text="actions" Classes="hint" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <CheckBox Content="Run for" IsChecked="{Binding StopAfterTimeEnabled}"
                                                  MinWidth="86"/>
                                        <TextBox Width="56"
                                                 Text="{Binding StopAfterMinutes, Converter={x:Static vm:IntTextConverter.Instance}}"
                                                 IsEnabled="{Binding StopAfterTimeEnabled}"/>
                                        <TextBlock Text="min" Classes="hint" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Classes="panel" Margin="0,8,0,0">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,7">
                                    <TextBlock Grid.Column="0" Classes="section" Text="RUN HISTORY"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="tiny" Content="Clear"
                                            Command="{Binding ClearHistoryCommand}"
                                            IsEnabled="{Binding HasHistory}"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Classes="hint" IsVisible="{Binding !HasHistory}"
                                           Text="Runs you complete will be listed here."/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              IsVisible="{Binding HasHistory}">
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="svc:RunRecord">
                                                <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="5"
                                                        Padding="8,6" Margin="0,0,0,5">
                                                    <StackPanel Spacing="2">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding PresetName}" Classes="cell"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Outcome}" Classes="hint"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Summary}" Classes="hint"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Classes="panel" Margin="0,8,0,0" MinHeight="132"
                        IsVisible="{Binding ShowPresetsPanel}">
                    <Grid ColumnDefinitions="210,Auto,*">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Classes="section" Text="PRESET"/>
                            <TextBox Text="{Binding PresetName}" HorizontalAlignment="Stretch"/>
                            <UniformGrid Columns="3">
                                <Button Classes="tiny" Content="Save changes" Margin="0,0,3,0"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding SaveChangesCommand}"
                                        IsEnabled="{Binding HasLoadedPreset}"
                                        Classes.flash="{Binding SaveFlash}"/>
                                <Button Classes="tiny" Content="Save as new" Margin="3,0"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding SavePresetCommand}"/>
                                <Button Classes="tiny" Content="Rename" Margin="3,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding RenamePresetCommand}"
                                        IsEnabled="{Binding HasLoadedPreset}"/>
                            </UniformGrid>
                        </StackPanel>

                        <Border Grid.Column="1" Classes="vsep" Margin="12,2"/>

                        <StackPanel Grid.Column="2" Spacing="6">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Classes="section" Text="SAVED PRESETS"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="tiny" Content="Load selected"
                                        HorizontalAlignment="Right"
                                        Command="{Binding LoadPresetCommand}"
                                        Classes.flash="{Binding LoadFlash}"/>
                            </Grid>

                            <TextBlock Classes="hint" IsVisible="{Binding !HasPresets}"
                                       Text="No presets yet. Record something, name it, then Save as new."/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding HasPresets}">
                                <ListBox ItemsSource="{Binding PresetEntries}"
                                         SelectedItem="{Binding SelectedEntry}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PresetEntry">
                                            <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="5"
                                                    Padding="9,8" Width="156">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Star}"
                                                               Foreground="{DynamicResource Amber}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               Margin="0,0,5,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Classes="cell"/>
                                                        <TextBlock Text="{Binding Description}" Classes="hint"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="tiny" Content="•••"
                                                            Background="Transparent" VerticalAlignment="Center">
                                                        <Button.Flyout>
                                                            <MenuFlyout>
                                                                <MenuItem Header="Load"
                                                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadPresetCommand}"/>
                                                                <MenuItem Header="Append to timeline"
                                                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AppendPresetCommand}"/>
                                                                <Separator/>
                                                                <MenuItem Header="Toggle favorite"
                                                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleFavoriteCommand}"
                                                                          CommandParameter="{Binding}"/>
                                                                <Separator/>
                                                                <MenuItem Header="Delete"
                                                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeletePresetCommand}"/>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsStacked}">
                <StackPanel Spacing="12" MaxWidth="580" HorizontalAlignment="Center" Margin="20,24">

                    <Border Classes="panel">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{Binding StatusColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusText}" Classes="cell" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" Classes="cellmuted"/>
                            </Grid>

                            <TextBlock Classes="hint" Text="{Binding Log}"/>

                            <Border Classes="divider"/>

                            <UniformGrid Columns="2">
                                <Button Classes="record" Content="Record" Margin="0,0,4,0"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding RecordCommand}" IsEnabled="{Binding !IsRecording}"/>
                                <Button Content="Stop recording" Margin="4,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding StopRecordingButtonCommand}"
                                        IsEnabled="{Binding IsRecording}"/>
                            </UniformGrid>

                            <UniformGrid Columns="3">
                                <Button Classes="primary" Content="Start" Margin="0,0,3,0"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/>
                                <Button Classes="pause" Content="{Binding PauseButtonLabel}" Margin="3,0"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding TogglePauseCommand}" IsEnabled="{Binding IsRunning}"/>
                                <Button Content="Stop" Margin="3,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,*">
                        <Border Grid.Column="0" Classes="panel" Margin="0,0,6,0">
                            <StackPanel Spacing="9">
                                <TextBlock Classes="section" Text="PLAYBACK"/>
                                <Grid ColumnDefinitions="58,*" RowDefinitions="Auto,Auto" RowSpacing="7">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Repeat" Classes="cell"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding LoopOptions}" SelectedItem="{Binding SelectedLoop}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed" Classes="cell"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding SelectedSpeed}"/>
                                </Grid>
                                <CheckBox Content="Natural clicks" IsChecked="{Binding NaturalClicks}"/>
                                <CheckBox Content="Smooth cursor travel" IsChecked="{Binding SmoothTravel}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Classes="panel" Margin="6,0,0,0">
                            <StackPanel Spacing="9">
                                <TextBlock Classes="section" Text="PRESETS"/>
                                <TextBox Text="{Binding PresetName}" HorizontalAlignment="Stretch"/>
                                <Button Classes="tiny" Content="Save as preset" HorizontalAlignment="Stretch"
                                        Command="{Binding SavePresetCommand}"
                                        Classes.flash="{Binding SaveFlash}"/>
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                          HorizontalAlignment="Stretch" PlaceholderText="Select preset"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="tiny" Content="Load"
                                            HorizontalAlignment="Stretch" Margin="0,0,6,0"
                                            Command="{Binding LoadPresetCommand}"
                                            Classes.flash="{Binding LoadFlash}"/>
                                    <Button Grid.Column="1" Classes="tiny danger" Content="Delete"
                                            Command="{Binding DeletePresetCommand}"
                                            Classes.flash="{Binding DeleteFlash}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Classes="panel">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="cell" HorizontalAlignment="Center"
                                       Text="{Binding TimelineSummary}"/>
                            <TextBlock Classes="hint" TextAlignment="Center" IsVisible="{Binding ShowHints}"
                                       Text="Switch to Advanced for the timeline editor, hotkeys and per-step settings."/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Panel>

        <Border Grid.Row="2" Classes="bar" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="{Binding StatusColor}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" Classes="cell"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="cell" Foreground="{DynamicResource TextMuted}"
                           Margin="22,0,0,0"
                           Text="{Binding PresetName, StringFormat='Preset: {0}'}"/>
                <TextBlock Grid.Column="2" Classes="cell" Foreground="{DynamicResource TextMuted}"
                           Margin="22,0,0,0">
                    <Run Text="{Binding LoadedCount}" Foreground="{DynamicResource Accent}" FontWeight="Bold"/><Run Text=" actions"/>
                </TextBlock>
                <TextBlock Grid.Column="3" Classes="cell" Foreground="{DynamicResource TextMuted}"
                           Margin="22,0,0,0" Text="{Binding LoopProgress}"/>
                <TextBlock Grid.Column="5" Classes="cell" Foreground="{DynamicResource TextMuted}"
                           Text="{Binding SpeedLabel, StringFormat='Speed: {0}'}"/>
            </Grid>
        </Border>

    </Grid>
</Window>